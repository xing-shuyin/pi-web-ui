{
  "name": "pi-web-ui",
  "version": "0.18.0",
  "description": "Web chat interface for the pi coding agent, powered by the pi SDK (@earendil-works/pi-coding-agent) — one-command run, Docker/systemd/launchd deployable",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pi-web-ui": "bin/pi-web-ui.mjs"
  },
  "main": "dist/server/index.js",
  "files": [
    "bin/",
    "dist/",
    "web/dist/",
    "web/public/",
    "deploy/",
    "extensions/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "coding-agent",
    "ai",
    "chat",
    "web-ui",
    "terminal",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xing-shuyin/pi-web-ui.git"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --import tsx server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test:freeze": "node freeze-test.mjs",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^4.21.2",
    "highlight.js": "^11.10.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "typebox": "1.3.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
