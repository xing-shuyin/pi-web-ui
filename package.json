{
	"name": "pi-web-ui",
	"version": "0.81.2",
	"description": "Web chat interface for the pi coding agent, powered by the pi SDK (@earendil-works/pi-coding-agent) — one-command run, Docker/systemd/launchd deployable",
	"license": "MIT",
	"author": {
		"name": "xingshuyin",
		"email": "xingshuyin@users.noreply.github.com"
	},
	"type": "module",
	"bin": {
		"pi-web-ui": "bin/pi-web-ui.mjs"
	},
	"main": "bin/pi-web-ui.mjs",
	"files": [
		"bin/",
		"dist/",
		"!dist/desktop",
		"web/dist/",
		"web/public/",
		"themes/",
		"deploy/",
		"extensions/",
		"plugins/catalog.json",
		"CHANGELOG.md",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"pi",
		"pi-package",
		"coding-agent",
		"ai",
		"chat",
		"web-ui",
		"terminal",
		"llm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xing-shuyin/pi-web-ui.git"
	},
	"pi": {
		"extensions": [
			"./extensions"
		],
		"image": "https://raw.githubusercontent.com/xing-shuyin/pi-web-ui/main/assets/chat-prompts.jpeg"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"prepublishOnly": "npm run build",
		"dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
		"dev:server": "cross-env PI_WEB_PORT=8788 PI_WEB_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 node --watch --import tsx server/index.ts",
		"dev:web": "vite --config web/vite.config.ts",
		"build": "npm run build:web && npm run build:server && npm run build:dsh-runtime && npm run build:mermaid-vendor && npm run build:runtrace-vendor",
		"build:web": "vite build --config web/vite.config.ts",
		"build:server": "tsc -p tsconfig.server.json",
		"build:dsh-runtime": "node scripts/copy-dsh-runtime.mjs",
		"build:mermaid-vendor": "node scripts/build-mermaid-vendor.mjs",
		"build:extension": "node plugins/page-picker/extension/build.mjs",
		"pack:extension": "node plugins/page-picker/extension/pack.mjs",
		"build:runtrace-vendor": "node scripts/build-runtrace-vendor.mjs",
		"typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p desktop/tsconfig.json --noEmit && tsc -p plugins/page-picker/extension/tsconfig.json --noEmit",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:smoke": "node tests/run-smoke.mjs",
		"check:protocol": "node scripts/check-protocol-sync.mjs",
		"i18n:diff": "node scripts/i18n-diff.mjs",
		"release:notes": "node scripts/release-notes.mjs",
		"changelog:i18n": "node scripts/release-notes.mjs --unreleased",
		"test:freeze": "node tests/freeze-test.mjs",
		"start": "node dist/server/index.js",
		"build:desktop": "tsc -p desktop/tsconfig.json",
		"desktop:dev": "npm run build:desktop && electron dist/desktop/main.js",
		"desktop:dist": "npm run build && npm run build:desktop && electron-builder -c desktop/electron-builder.yml",
		"format": "prettier --write server/ web/src/ extensions/ scripts/ bin/ desktop/ tests/*.mjs tests/unit/ *.mjs",
		"format:check": "prettier --check server/ web/src/ extensions/ scripts/ bin/ desktop/ tests/*.mjs tests/unit/ *.mjs",
		"lint": "oxlint server/ web/src/ extensions/ scripts/ desktop/",
		"lint:fix": "oxlint --fix server/ web/src/ extensions/ scripts/ desktop/"
	},
	"dependencies": {
		"@deepseek-ai/dsh-sdk-jsonrpc-server": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-sdk-protocol": "^0.1.1-rc.2",
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"compression": "^1.8.1",
		"express": "^4.21.2",
		"highlight.js": "^11.10.0",
		"katex": "^0.16.47",
		"node-pty": "^1.1.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-icons": "^5.7.0",
		"react-markdown": "^9.0.1",
		"rehype-highlight": "^7.0.1",
		"rehype-katex": "^7.0.1",
		"rehype-raw": "^7.0.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.0",
		"remark-math": "^6.0.0",
		"typebox": "^1.3.14",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@types/compression": "^1.8.1",
		"@types/express": "^4.17.21",
		"@types/node": "^22.10.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/ws": "^8.5.13",
		"@vitejs/plugin-react": "^4.3.4",
		"concurrently": "^9.1.0",
		"cross-env": "^10.1.0",
		"esbuild": "^0.25.12",
		"electron": "^44.0.0",
		"electron-builder": "^26.0.0",
		"jsdom": "^26.1.0",
		"mermaid": "^11.17.2",
		"oxlint": "^1.81.0",
		"playwright-core": "^1.62.1",
		"prettier": "^3.9.6",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"vis-timeline": "^8.5.4",
		"vite": "^6.0.3",
		"vitest": "^4.1.11"
	},
	"allowScripts": {
		"node-pty@1.1.0": true
	}
}
