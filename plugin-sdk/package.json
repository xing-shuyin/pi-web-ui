{
	"name": "@pi-web-ui/plugin-sdk",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"description": "Server, browser, and test helpers + types for pi-web-ui plugins.",
	"main": "index.mjs",
	"types": "index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.mjs"
		},
		"./client": {
			"types": "./client.d.ts",
			"default": "./client.mjs"
		},
		"./testing": {
			"types": "./testing.d.ts",
			"default": "./testing.mjs"
		},
		"./client-utils": "./client-utils.mjs"
	}
}
