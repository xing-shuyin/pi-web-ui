{
	"name": "@pi-mobile/native-local-engine",
	"version": "0.1.0",
	"private": true,
	"description": "Local Capacitor plugin: bundled Linux rootfs + Node engine (proot, no root) hosting pi-web-ui on-device",
	"type": "module",
	"main": "src/index.ts",
	"module": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"src/",
		"android/",
		"tsconfig.json"
	],
	"scripts": {
		"typecheck": "tsc --project tsconfig.json"
	},
	"peerDependencies": {
		"@capacitor/core": "^8.6.0"
	},
	"capacitor": {
		"android": {
			"src": "android"
		}
	}
}
