{
	"name": "@pi-mobile/native-push",
	"version": "0.1.0",
	"private": true,
	"description": "Local Capacitor JPush and encrypted connection credential plugins",
	"type": "module",
	"main": "src/index.ts",
	"module": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"src/",
		"android/",
		"ios/",
		"tsconfig.json",
		"PiMobileNativePush.podspec"
	],
	"scripts": {
		"typecheck": "tsc --project tsconfig.json"
	},
	"peerDependencies": {
		"@capacitor/core": "^8.6.0"
	},
	"capacitor": {
		"android": {
			"src": "android"
		},
		"ios": {
			"src": "ios"
		}
	}
}
