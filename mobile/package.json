{
	"name": "@pi-web-ui/mobile",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 127.0.0.1 --port 8910",
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"sync": "npm run build && cap sync",
		"icons": "node scripts/gen-app-icon.mjs",
		"apk": "npm run sync && node scripts/build-apk.mjs",
		"apk:all": "node scripts/package-all.mjs",
		"apk:all:runtime": "node scripts/package-all.mjs --with-runtime",
		"android": "cap open android",
		"ios": "cap open ios",
		"native:configure": "node --env-file-if-exists=.env scripts/configure-native.mjs",
		"native:check": "node scripts/configure-native.mjs --check",
		"native:add": "cap add"
	},
	"dependencies": {
		"@capacitor/android": "^8.6.0",
		"@capacitor/app": "^8.0.0",
		"@capacitor/core": "^8.6.0",
		"@capacitor/ios": "^8.6.0",
		"@capacitor/keyboard": "^8.0.0",
		"@capacitor/network": "^8.0.0",
		"@capacitor/splash-screen": "^8.0.0",
		"@capacitor/status-bar": "^8.0.0",
		"@pi-mobile/native-local-engine": "file:./native/local-engine",
		"@pi-mobile/native-phone-control": "file:./native/phone-control",
		"@pi-mobile/native-push": "file:./native/push",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.6.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	}
}
